{
  "name": "simcity-dnd",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate:forest-assets": "node scripts/generate-forest-assets.mjs",
    "extract:authored-assets": "node scripts/extract-authored-assets.mjs && npm run optimize:runtime-assets",
    "optimize:runtime-assets": "node scripts/optimize-runtime-assets.mjs",
    "prepare:wildlife-assets": "node scripts/prepare-wildlife-assets.mjs && npm run optimize:runtime-assets",
    "validate:extracted-assets": "node scripts/validate-extracted-assets.mjs",
    "validate:runtime-assets": "node scripts/validate-runtime-assets.mjs",
    "validate:wildlife-assets": "node scripts/validate-wildlife-assets.mjs",
    "validate:forest-assets": "node scripts/validate-forest-assets.mjs",
    "bake:impostors": "node scripts/bake-tree-impostors.mjs",
    "validate:impostors": "node scripts/validate-impostors.mjs",
    "validate:impostors:required": "node scripts/validate-impostors.mjs --required",
    "validate:assets": "node scripts/validate-assets.mjs && npm run validate:extracted-assets && npm run validate:runtime-assets && npm run validate:wildlife-assets && npm run validate:forest-assets && npm run validate:impostors",
    "validate:assets:production": "node scripts/validate-assets.mjs && npm run validate:extracted-assets && npm run validate:runtime-assets && npm run validate:wildlife-assets && npm run validate:forest-assets && npm run validate:impostors:required",
    "test": "node --test",
    "qa:perf": "node scripts/run-perf-qa.mjs",
    "qa:perf:matrix": "node scripts/run-perf-matrix.mjs",
    "qa:perf:parse": "node scripts/parse-perf-qa.mjs",
    "qa:collision:install": "playwright install chromium",
    "qa:collision": "node scripts/run-collision-acceptance.mjs",
    "qa:collision:release": "node scripts/run-collision-acceptance.mjs --release",
    "qa:water:acceptance": "node scripts/run-water-acceptance-qa.mjs",
    "qa:spells": "node --test test/spell-runtime-contract.test.js test/spell-terrain-adapter.test.js test/spell-config-runtime.test.js test/spell-menu-contract.test.js test/spell-precompiler.test.js test/spell-vfx-performance-contract.test.js test/earth-spell-gameplay-config.test.js test/spell-hotkey-precedence.test.js",
    "qa:assets:startup": "node scripts/run-asset-startup-qa.mjs",
    "qa:vegetation:lod": "node scripts/run-vegetation-lod-qa.mjs",
    "qa:postprocessing": "node scripts/run-post-processing-qa.mjs",
    "qa:postprocessing:install": "playwright install chromium",
    "qa:postprocessing:browser": "node scripts/run-post-processing-browser-qa.mjs",
    "verify:asset-serving": "node scripts/verify-asset-serving.mjs",
    "qa:workshop:install": "playwright install chromium",
    "qa:workshop": "node scripts/run-workshop-qa.mjs",
    "qa:inventory": "node scripts/run-inventory-qa.mjs",
    "qa:construction:joints": "node scripts/run-construction-joint-width-qa.mjs",
    "qa:construction:relief": "node scripts/run-construction-stone-relief-qa.mjs",
    "qa:construction:edge-wear": "node scripts/run-construction-stone-edge-wear-qa.mjs",
    "qa:construction:lod": "node scripts/run-construction-stone-lod-qa.mjs",
    "qa:construction:ruin": "node scripts/run-construction-ruin-qa.mjs",
    "verify": "npm run validate:assets:production && npm test && npm run build",
    "extract:grass-profiles": "node scripts/extract-grass-blade-profiles.mjs"
  },
  "dependencies": {
    "js-yaml": "4.3.0",
    "polygon-clipping": "0.15.7",
    "straight-skeleton": "1.1.0",
    "three": "0.185.1",
    "three-mesh-bvh": "0.9.13"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@img/sharp-wasm32": "^0.35.3",
    "gltf-validator": "2.0.0-dev.3.10",
    "meshoptimizer": "^1.2.0",
    "playwright": "1.62.0",
    "sharp": "^0.35.3",
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
